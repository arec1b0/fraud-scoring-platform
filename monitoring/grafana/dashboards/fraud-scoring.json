{
  "id": null,
  "uid": "fraud-scoring-overview",
  "title": "FraudScoring Overview",
  "description": "Operational metrics for the real-time fraud scoring API.",
  "tags": [
    "fraud",
    "mlops",
    "scoring"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "p95 Scoring Latency",
      "description": "Estimated p95 application-level HTTP latency for all scoring outcomes. The reference threshold is 50 ms.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fraud-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fraud_scoring_http_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Scoring Requests / Second",
      "description": "Throughput across successful and failed scoring requests.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fraud-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(fraud_scoring_http_requests_total[$__rate_interval]))",
          "legendFormat": "Requests / second",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP 5xx Error Rate",
      "description": "Server error responses divided by all scoring requests. A missing request denominator is shown as no data.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fraud-prometheus"
          },
          "editorMode": "code",
          "expr": "(sum(rate(fraud_scoring_http_requests_total{status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(fraud_scoring_http_requests_total[$__rate_interval]))",
          "legendFormat": "5xx fraction",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Approval Rate",
      "description": "APPROVE decisions divided by all completed decisions. Failed scoring requests are excluded.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fraud-prometheus"
          },
          "editorMode": "code",
          "expr": "(sum(rate(fraud_scoring_decisions_total{decision=\"APPROVE\"}[$__rate_interval])) or vector(0)) / sum(rate(fraud_scoring_decisions_total[$__rate_interval]))",
          "legendFormat": "Approval fraction",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Decision Throughput",
      "description": "Completed APPROVE, REVIEW, and DECLINE decisions per second.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fraud-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (decision) (rate(fraud_scoring_decisions_total[$__rate_interval]))",
          "legendFormat": "{{decision}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Fraud Risk Score Distribution",
      "description": "Pre-bucketed score distribution over time, from successful scoring responses only. Score values range from 0 to 1.",
      "type": "heatmap",
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "fill": "dark-orange",
          "scale": "exponential",
          "exponent": 0.5,
          "steps": 64,
          "reverse": false
        },
        "rowsFrame": {
          "layout": "auto"
        },
        "yAxis": {
          "axisPlacement": "left",
          "reverse": false,
          "unit": "short"
        },
        "legend": {
          "show": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fraud-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (le) (rate(fraud_scoring_risk_score_bucket[$__rate_interval]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "range": true
        }
      ]
    }
  ]
}
